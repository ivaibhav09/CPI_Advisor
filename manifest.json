{
    "manifest_version":  3,
    "name":  "SAP CPI Migration Copilot",
    "version":  "1.0.0",
    "permissions":  [
                        "storage",
                        "sidePanel",
                        "activeTab"
                    ],
    "host_permissions":  [
                             "https://*.hana.ondemand.com/*"
                         ],
    "background":  {
                       "service_worker":  "background.js"
                   },
    "action":  {
                   "default_title":  "SAP CPI Migration Copilot"
               },
    "side_panel":  {
                       "default_path":  "sidepanel.html"
                   },
    "content_scripts":  [
                            {
                                "matches":  [
                                                "https://*.hana.ondemand.com/*"
                                            ],
                                "js":  [
                                           "content.js"
                                       ],
                                "all_frames":  true,
                                "run_at":  "document_idle"
                            }
                        ]
}
